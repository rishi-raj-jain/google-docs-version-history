# Production Postgres (stores document_versions metadata — run scripts/create-versions-table.sql)
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Neon Console API (server-side only): https://neon.tech/docs/manage/api-keys
NEON_API_KEY=
NEON_PROJECT_ID=

# Optional: branch to branch from when saving (defaults to project default branch)
# NEON_PARENT_BRANCH_ID=br-...

# Optional: branch that receives restore operations (defaults to default branch)
# NEON_MAIN_BRANCH_ID=br-...

# Optional: prefix for preserve_under_name when calling restore
# NEON_RESTORE_PRESERVE_PREFIX=pre-restore

# Optional: default author label in version history
# VERSION_AUTHOR_LABEL=You

# Recommended in production: encode stored branch URIs with AES-GCM (any secret 16+ chars)
# BRANCH_URI_SECRET=
